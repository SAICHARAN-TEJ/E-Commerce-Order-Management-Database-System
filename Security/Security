-- student questions
-- 1. full access to everyone means anyone can change or delete data by mistake or on purpose
-- 2. payment data leaks or gets tampered with, which causes fraud and legal trouble
-- 3. permissions are given to a role once, so users only get what their job needs and it is easy to manage


-- 4. performance
DROP PROCEDURE IF EXISTS sp_add_index;
DELIMITER //
CREATE PROCEDURE sp_add_index(IN p_table VARCHAR(64), IN p_index VARCHAR(64), IN p_cols VARCHAR(200))
BEGIN
    IF NOT EXISTS (SELECT 1 FROM information_schema.statistics
                   WHERE table_schema = DATABASE() AND table_name = p_table AND index_name = p_index) THEN
        SET @ddl = CONCAT('CREATE INDEX ', p_index, ' ON ', p_table, '(', p_cols, ')');
        PREPARE stmt FROM @ddl;
        EXECUTE stmt;
        DEALLOCATE PREPARE stmt;
    END IF;
END //
DELIMITER ;

-- before indexes
EXPLAIN ANALYZE SELECT * FROM Product WHERE Name = 'Air Fryer 4L';
EXPLAIN ANALYZE SELECT * FROM Customer WHERE Phone = '9000011111';
EXPLAIN ANALYZE SELECT * FROM Orders WHERE OrderDate BETWEEN '2026-07-01' AND '2026-07-31';

-- foreign keys and UNIQUE columns (CategoryID, CustomerID, Email) already have indexes, so only these three are new
CALL sp_add_index('Product', 'idx_product_name', 'Name');
CALL sp_add_index('Customer', 'idx_customer_phone', 'Phone');
CALL sp_add_index('Orders', 'idx_order_date', 'OrderDate');
DROP PROCEDURE sp_add_index;

-- after indexes
EXPLAIN ANALYZE SELECT * FROM Product WHERE Name = 'Air Fryer 4L';
EXPLAIN ANALYZE SELECT * FROM Customer WHERE Phone = '9000011111';
EXPLAIN ANALYZE SELECT * FROM Orders WHERE OrderDate BETWEEN '2026-07-01' AND '2026-07-31';


