USE ecommerce_db;

-- 1. users and roles (demo passwords, change them for anything real)
CREATE ROLE IF NOT EXISTS admin_role, sales_role, inventory_role, support_role;

CREATE USER IF NOT EXISTS 'admin_user'@'localhost' IDENTIFIED BY 'Admin@123';
CREATE USER IF NOT EXISTS 'sales_user'@'localhost' IDENTIFIED BY 'Sales@123';
CREATE USER IF NOT EXISTS 'inventory_user'@'localhost' IDENTIFIED BY 'Inventory@123';
CREATE USER IF NOT EXISTS 'support_user'@'localhost' IDENTIFIED BY 'Support@123';

-- 2. grant permissions to roles
GRANT ALL ON ecommerce_db.* TO admin_role;
GRANT CREATE USER ON *.* TO admin_role;

GRANT SELECT ON ecommerce_db.Orders TO sales_role;
GRANT SELECT ON ecommerce_db.OrderItems TO sales_role;
GRANT SELECT ON ecommerce_db.Product TO sales_role;

GRANT SELECT ON ecommerce_db.Product TO inventory_role;
GRANT UPDATE (StockQuantity) ON ecommerce_db.Product TO inventory_role;

-- support sees customers and orders, but never the Password column
GRANT SELECT (CustomerID, Name, Email, Phone, Address, RegistrationDate) ON ecommerce_db.Customer TO support_role;
GRANT SELECT ON ecommerce_db.Orders TO support_role;

GRANT admin_role TO 'admin_user'@'localhost';
GRANT sales_role TO 'sales_user'@'localhost';
GRANT inventory_role TO 'inventory_user'@'localhost';
GRANT support_role TO 'support_user'@'localhost';
SET DEFAULT ROLE ALL TO 'admin_user'@'localhost', 'sales_user'@'localhost',
                        'inventory_user'@'localhost', 'support_user'@'localhost';

-- revoke demo
GRANT INSERT ON ecommerce_db.Payment TO 'sales_user'@'localhost';
SHOW GRANTS FOR 'sales_user'@'localhost';
REVOKE INSERT ON ecommerce_db.Payment FROM 'sales_user'@'localhost';
SHOW GRANTS FOR 'sales_user'@'localhost';

