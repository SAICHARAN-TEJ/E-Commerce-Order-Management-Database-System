-- customer intelligence
SELECT c.Name, COUNT(o.OrderID) AS Orders, SUM(o.TotalAmount) AS Spent,
       CASE WHEN SUM(o.TotalAmount) >= 5000 THEN 'High Value'
            WHEN SUM(o.TotalAmount) >= 1500 THEN 'Regular'
            ELSE 'Low Value' END AS Segment
FROM Customer c
JOIN Orders o ON o.CustomerID = c.CustomerID AND o.OrderStatus NOT IN ('cancelled', 'returned')
GROUP BY c.CustomerID, c.Name ORDER BY Spent DESC LIMIT 10;

-- inventory intelligence
SELECT p.Name, p.StockQuantity, v.QtySold,
       CASE WHEN p.StockQuantity < 30 THEN 'Low Stock'
            WHEN p.StockQuantity > 250 THEN 'Overstocked'
            ELSE 'OK' END AS StockStatus
FROM Product p JOIN v_product_performance v ON v.ProductID = p.ProductID
ORDER BY v.QtySold DESC;

