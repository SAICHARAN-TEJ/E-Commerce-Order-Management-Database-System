-- 3. views (cancelled and returned orders don't count as sales)
CREATE OR REPLACE VIEW v_customer_order_history AS
SELECT c.CustomerID, c.Name AS CustomerName, o.OrderID, o.OrderDate, o.TotalAmount, o.OrderStatus
FROM Customer c JOIN Orders o ON o.CustomerID = c.CustomerID;

CREATE OR REPLACE VIEW v_sales_report AS
SELECT DATE_FORMAT(OrderDate, '%Y-%m') AS SalesMonth, COUNT(*) AS Orders, SUM(TotalAmount) AS Revenue
FROM Orders WHERE OrderStatus NOT IN ('cancelled', 'returned')
GROUP BY SalesMonth;

CREATE OR REPLACE VIEW v_product_performance AS
SELECT p.ProductID, p.Name AS ProductName, p.CategoryID,
       IFNULL(SUM(s.Quantity), 0) AS QtySold,
       IFNULL(SUM(s.Quantity * s.PriceAtPurchase), 0) AS Revenue
FROM Product p
LEFT JOIN (SELECT oi.ProductID, oi.Quantity, oi.PriceAtPurchase
           FROM OrderItems oi JOIN Orders o ON o.OrderID = oi.OrderID
           WHERE o.OrderStatus NOT IN ('cancelled', 'returned')) s ON s.ProductID = p.ProductID
GROUP BY p.ProductID, p.Name, p.CategoryID;

SELECT ProductName, Revenue, RANK() OVER (ORDER BY Revenue DESC) AS RevenueRank
FROM v_product_performance;


-- 4. functions
DROP FUNCTION IF EXISTS fn_customer_spending;
CREATE FUNCTION fn_customer_spending(p_id INT) RETURNS DECIMAL(12,2) READS SQL DATA
RETURN (SELECT IFNULL(SUM(TotalAmount), 0) FROM Orders
        WHERE CustomerID = p_id AND OrderStatus NOT IN ('cancelled', 'returned'));

DROP FUNCTION IF EXISTS fn_product_revenue;
CREATE FUNCTION fn_product_revenue(p_id INT) RETURNS DECIMAL(12,2) READS SQL DATA
RETURN (SELECT IFNULL(SUM(oi.Quantity * oi.PriceAtPurchase), 0)
        FROM OrderItems oi JOIN Orders o ON o.OrderID = oi.OrderID
        WHERE oi.ProductID = p_id AND o.OrderStatus NOT IN ('cancelled', 'returned'));


-- 5. procedures
DROP PROCEDURE IF EXISTS sp_update_stock;
CREATE PROCEDURE sp_update_stock(IN p_prod INT, IN p_qty INT)
UPDATE Product SET StockQuantity = StockQuantity + p_qty WHERE ProductID = p_prod;

DROP PROCEDURE IF EXISTS sp_sales_total;
CREATE PROCEDURE sp_sales_total(IN p_from DATE, IN p_to DATE)
SELECT SUM(TotalAmount) AS TotalSales, COUNT(*) AS TotalOrders
FROM Orders
WHERE OrderStatus NOT IN ('cancelled', 'returned')
  AND OrderDate >= p_from AND OrderDate < p_to + INTERVAL 1 DAY;

-- the procedure takes the stock down, trg_payment_status moves the order status
DROP PROCEDURE IF EXISTS sp_place_order;
DELIMITER //
CREATE PROCEDURE sp_place_order(IN p_cust INT, IN p_prod INT, IN p_qty INT, IN p_method VARCHAR(20))
BEGIN
    DECLARE v_price DECIMAL(10,2);
    DECLARE v_stock INT;
    DECLARE v_order INT;
    DECLARE EXIT HANDLER FOR SQLEXCEPTION
    BEGIN
        ROLLBACK;
        RESIGNAL;
    END;

    IF p_qty < 1 THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Quantity must be at least 1';
    END IF;

    START TRANSACTION;
    SELECT Price, StockQuantity INTO v_price, v_stock FROM Product WHERE ProductID = p_prod FOR UPDATE;

    IF v_price IS NULL THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Product not found';
    END IF;
    IF v_stock < p_qty THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Product out of stock';
    END IF;

    INSERT INTO Orders (CustomerID, TotalAmount) VALUES (p_cust, v_price * p_qty);
    SET v_order = LAST_INSERT_ID();

    INSERT INTO OrderItems (OrderID, ProductID, Quantity, PriceAtPurchase)
    VALUES (v_order, p_prod, p_qty, v_price);

    UPDATE Product SET StockQuantity = StockQuantity - p_qty WHERE ProductID = p_prod;

    INSERT INTO Payment (OrderID, PaymentMethod, PaymentStatus, AmountPaid)
    VALUES (v_order, p_method, IF(p_method = 'cash_on_delivery', 'pending', 'success'), v_price * p_qty);
    COMMIT;

    SELECT * FROM v_customer_order_history WHERE OrderID = v_order;
END //
DELIMITER ;


-- 6. triggers
CREATE TABLE IF NOT EXISTS Audit_Log (
    LogID     INT AUTO_INCREMENT PRIMARY KEY,
    OrderID   INT,
    OldStatus VARCHAR(20),
    NewStatus VARCHAR(20),
    ChangedAt DATETIME DEFAULT CURRENT_TIMESTAMP
);

DROP TRIGGER IF EXISTS trg_check_stock;
DROP TRIGGER IF EXISTS trg_payment_status;
DROP TRIGGER IF EXISTS trg_order_audit;

DELIMITER //
CREATE TRIGGER trg_check_stock BEFORE INSERT ON OrderItems FOR EACH ROW
BEGIN
    IF NEW.Quantity > (SELECT StockQuantity FROM Product WHERE ProductID = NEW.ProductID) THEN
        SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Product out of stock';
    END IF;
END //
DELIMITER ;

CREATE TRIGGER trg_payment_status AFTER INSERT ON Payment FOR EACH ROW
UPDATE Orders
SET OrderStatus = CASE NEW.PaymentStatus WHEN 'success' THEN 'packed' WHEN 'failed' THEN 'cancelled' ELSE OrderStatus END
WHERE OrderID = NEW.OrderID AND OrderStatus = 'placed';

CREATE TRIGGER trg_order_audit AFTER UPDATE ON Orders FOR EACH ROW
INSERT INTO Audit_Log (OrderID, OldStatus, NewStatus)
SELECT OLD.OrderID, OLD.OrderStatus, NEW.OrderStatus FROM DUAL WHERE OLD.OrderStatus <> NEW.OrderStatus;


